        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "name": "Prometheus"
          },
          "editorMode": "code",
          "expr": "up",
          "legendFormat": "Service Uptime: {{job}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "name": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(http_requests_total)",
          "legendFormat": "Total HTTP Requests",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Backend Health & Request Volume",
      "type": "timeseries"
