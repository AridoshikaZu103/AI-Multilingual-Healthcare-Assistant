          "legendFormat": "CPU Time (s)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU Usage (Backend Total)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "name": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 250 },
              { "color": "red", "value": 450 }
            ]
          },
          "unit": "megabytes"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "name": "Prometheus"
          },
          "editorMode": "code",
          "expr": "process_resident_memory_bytes{job=\"healthcare-backend\"} / 1024 / 1024",
          "legendFormat": "Memory (MB)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Memory Usage (Backend MB)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "name": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Requests / Health (1=UP)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
